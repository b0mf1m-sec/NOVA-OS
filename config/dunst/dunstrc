[global]
    monitor = 0
    follow = none
    width = 350
    height = (0, 180)
    origin = top-right
    offset = (12, 40)
    notification_limit = 4
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 310
    progress_bar_max_width = 310
    progress_bar_corner_radius = 3
    indicate_hidden = yes
    transparency = 4
    separator_height = 0
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 1
    frame_color = "#3a3a3d"
    gap_size = 8
    sort = yes
    font = Inter 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = true
    icon_position = left
    min_icon_size = 34
    max_icon_size = 40
    icon_theme = "Papirus-Dark"
    enable_recursive_icon_lookup = true
    corner_radius = 14
    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = do_action, close_current
[urgency_low]
    background = "#2a2a2d"
    foreground = "#f5f5f7"
    highlight = "#0a84ff"
    timeout = 4
[urgency_normal]
    background = "#2a2a2d"
    foreground = "#f5f5f7"
    highlight = "#0a84ff"
    timeout = 6
[urgency_critical]
    background = "#2a2a2d"
    foreground = "#f5f5f7"
    frame_color = "#ff453a"
    highlight = "#ff453a"
    timeout = 0
