[Desktop Entry]
Type=Application
Name=Ajustes
Comment=Personalizar o sistema
Exec=@HOME@/.local/bin/nova-ajustes
Icon=@HOME@/.local/share/nova/icons/ajustes.png
Terminal=false
StartupWMClass=Nova-ajustes
Categories=Settings;

Actions=nova-janela;

[Desktop Action nova-janela]
Name=Abrir nova janela
Exec=@HOME@/.local/bin/nova-ajustes
