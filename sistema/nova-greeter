#!/bin/sh
# Greeter NOVA OS. Se o greeter próprio falhar ao iniciar, cai no greeter GTK padrão.
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
T0=$(date +%s)
LOG=/var/lib/lightdm/nova-greeter.log; touch "$LOG" 2>/dev/null || LOG=/dev/null
/usr/local/bin/nova-greeter-bin 2>>"$LOG"
RC=$?
[ $RC -eq 0 ] && exit 0
[ $(( $(date +%s) - T0 )) -gt 20 ] && exit $RC
exec /usr/sbin/lightdm-gtk-greeter
