#!/bin/bash
# Pausa o antivírus (clamscan) enquanto houver janela em tela cheia (vídeo) e retoma depois.
while sleep 5; do
  w=$(xprop -root _NET_ACTIVE_WINDOW | grep -o '0x[0-9a-f]*')
  if [ -n "$w" ] && xprop -id "$w" _NET_WM_STATE 2>/dev/null | grep -q FULLSCREEN \
     && ! xprop -id "$w" WM_CLASS | grep -q Nova-; then pkill -STOP -x clamscan; else pkill -CONT -x clamscan; fi
done
