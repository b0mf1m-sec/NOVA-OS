#!/bin/sh
# Dispara a varredura completa de tempos em tempos. Intervalo (dias) em "varredura_dias" (0 = desligado).
# Se o PC estava desligado na hora, roda na próxima vez que ligar (checa a cada 30 min, com bateria só se ligado na tomada).
E="$HOME/.local/share/nova/varredura.estado"; cfg() { "$HOME/.local/bin/nova-config" -g "$1" "$2"; }
sleep 300
while :; do
  d=$(cfg varredura_dias 7)
  if [ "$d" -gt 0 ] 2>/dev/null; then
    ultimo=$(awk '$1=="fim"{print $2}' "$E" 2>/dev/null); agora=$(date +%s)
    if [ -z "$ultimo" ] || [ $((agora - ultimo)) -ge $((d * 86400)) ]; then
      ac=$(cat /sys/class/power_supply/A*/online 2>/dev/null | head -1)
      mem=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo); carga=$(cut -d. -f1 /proc/loadavg)
      [ "${ac:-1}" = 1 ] && [ "${mem:-0}" -ge 1500 ] && [ "${carga:-9}" -lt 1 ] && "$HOME/.local/bin/nova-varredura" rapida   # só com memória sobrando e PC parado
    fi
  fi
  sleep 1800
done
