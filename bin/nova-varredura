#!/bin/sh
# Varredura completa do PC com o ClamAV. Uso: nova-varredura [parar]
# Estado em ~/.local/share/nova/varredura.estado (lido pelos Ajustes). Infectados vão para a quarentena.
D="$HOME/.local/share/nova"; Q="$D/quarentena"; E="$D/varredura.estado"; L="$D/antivirus.log"; mkdir -p "$Q"
if [ "$1" = parar ]; then pkill -x clamscan; exit 0; fi
command -v clamscan >/dev/null || { echo "erro" > "$E"; exit 1; }
pgrep -x clamscan >/dev/null && exit 0                          # já em andamento
echo "rodando $(date +%s)" > "$E"
out=$(nice -n 15 ionice -c3 clamscan -r -i --move="$Q" --cross-fs=no --max-filesize=100M --max-scansize=200M \
  --exclude-dir='^/proc' --exclude-dir='^/sys' --exclude-dir='^/dev' --exclude-dir='^/run' --exclude-dir='^/var/lib/clamav' \
  --exclude-dir="^$Q" --exclude-dir='^/snap' --exclude-dir='^/mnt' --exclude-dir='^/media' / 2>/dev/null); rc=$?
inf=$(echo "$out" | sed -n 's/^Infected files: //p'); tot=$(echo "$out" | sed -n 's/^Scanned files: //p')
chmod 000 "$Q"/* 2>/dev/null
if [ "$rc" -gt 1 ] || [ -z "$tot" ]; then echo "interrompida $(date +%s)" > "$E"; exit 0; fi
echo "fim $(date +%s) ${inf:-0} ${tot:-0}" > "$E"
echo "$(date '+%F %T') VARREDURA COMPLETA: ${tot:-0} arquivos, ${inf:-0} infectados" >> "$L"
if [ "${inf:-0}" -gt 0 ]; then
  notify-send -u critical -i /usr/share/icons/Papirus/48x48/status/dialog-warning.svg "Varredura concluída: ameaça encontrada" "$inf arquivo(s) com vírus foram movidos para a quarentena."
else
  notify-send -t 6000 -i /usr/share/icons/Papirus/48x48/apps/security-high.svg "Varredura concluída" "$tot arquivos verificados. Nenhuma ameaça encontrada."
fi
